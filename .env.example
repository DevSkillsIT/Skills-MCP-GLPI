# GLPI MCP Configuration

# GLPI Server Configuration
GLPI_BASE_URL=https://your-glpi-server.example.com
GLPI_APP_TOKEN=your_glpi_app_token_here

# Session Configuration (optional - can use APP TOKEN only)
GLPI_USER_TOKEN=

# Server Configuration
MCP_PORT=8824
MCP_HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=INFO
# Path to the log file (absolute or relative). Leave empty to log to stdout.
LOG_FILE=./logs/mcp-glpi.log

# Performance Configuration
CONNECTION_TIMEOUT=30
REQUEST_TIMEOUT=60
POOL_WORKERS=2

# Safety Guard Configuration (proteção contra operações destrutivas)
# Quando ativado, operações como delete_ticket, delete_asset, delete_user
# requerem confirmationToken e reason
MCP_SAFETY_GUARD=false
MCP_SAFETY_TOKEN=your_safety_token_here_min_8_chars

# =====================================================================
# Knowledge Base — unified vector search (tool: glpi_search_knowledge_unified)
# =====================================================================
# Optional. Enables semantic + full-text search over one or more vectorized
# sources, each exposing the kb_search contract (see
# src/services/kb_search/CONTRACT.md). Requires the optional deps:
#   pip install -r src/services/kb_search/requirements.txt
#
# Config lives in ONE place — the central MCP config:
#  - Multi-tenant (recommended): a "knowledge_base" section in the per-instance
#    JSON pointed to by GLPI_MCP_CONFIG (alongside glpi/client/safety sections).
#  - Single instance (.env fallback): the KNOWLEDGE_BASE var below, a JSON string.
#
# Full, readable example with every field:
#   src/services/kb_search/knowledge_base.example.json
#
# Structure (pretty here for readability — in .env it must be ONE line):
#   {
#     "embedding": { "provider": "vllm", "base_url": "...", "api_key": "...",
#                    "model": "/model", "dimensions": 2560 },
#     "sources": [
#       { "name": "chamados", "label": "CHAMADOS", "enabled": true,
#         "is_official": false, "dsn": "host=... dbname=glpi_kb ...",
#         "relation": "kb_search", "weight": 1.0, "dedup": false,
#         "lang": "pt-BR", "description": "Chamados resolvidos do GLPI." }
#     ]
#   }
#
# Source fields: name, label, dsn, relation (required) | enabled (default true —
# toggle off without deleting), is_official, weight (RRF boost), dedup
# (collapse repost titles), lang, description. provider: vllm | openai | none.
#
# KNOWLEDGE_BASE=

