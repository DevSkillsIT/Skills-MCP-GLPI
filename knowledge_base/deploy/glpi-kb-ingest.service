[Unit]
Description=GLPI tickets knowledge-base incremental ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust to your deployment:
WorkingDirectory=/opt/Skills-MCP-GLPI
# Central per-instance config (knowledge_base.ingestion section). Without it,
# the pipeline falls back to the single root .env.
Environment=GLPI_MCP_CONFIG=/path/to/instance/glpi-config.json
ExecStart=/opt/Skills-MCP-GLPI/.venv/bin/python -m knowledge_base.ingest_tickets
Nice=10
TimeoutStartSec=1800
